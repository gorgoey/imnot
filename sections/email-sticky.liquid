
{% comment %}
  IMNOTAMORNINGPERSON — Email Sticky
{% endcomment %}

{%- if section.settings.enable_sticky -%}
  <div
    id="EmailSticky-{{ section.id }}"
    class="imnot-email-sticky"
    role="region"
    aria-label="Email newsletter signup"
  >
    <button
      type="button"
      class="imnot-email-sticky__close"
      aria-label="Close newsletter signup"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 5L19 19M19 5L5 19"/>
      </svg>
    </button>

    <div class="imnot-email-sticky__content">

      {%- if section.settings.description != blank -%}
        <p class="imnot-email-sticky__description">
          {{ section.settings.description | escape }}
        </p>
      {%- endif -%}

      {%- assign sticky_form_id = 'EmailStickyForm-' | append: section.id -%}

      {%- form 'customer', id: sticky_form_id, class: 'imnot-email-sticky__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">

        {%- if form.posted_successfully? -%}
          <p class="imnot-email-sticky__message" role="status">
            {{ section.settings.success_message | escape }}
          </p>
        {%- else -%}
          <div class="imnot-email-sticky__field">
            <input
              id="EmailStickyInput-{{ section.id }}"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="Email"
              aria-label="Email address"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="EmailStickyError-{{ section.id }}"
              {% endif %}
              required
            >

            <button type="submit" aria-label="Subscribe">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 12H20M13 5L20 12L13 19"/>
              </svg>
            </button>
          </div>

          {%- if form.errors -%}
            <small
              id="EmailStickyError-{{ section.id }}"
              class="imnot-email-sticky__error"
              role="alert"
            >
              {{ form.errors.messages['email'] | escape }}
            </small>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}

    </div>
  </div>

  <style>
    #shop-hcaptcha-badge-container {
        visibility: hidden !important;
    }

    #EmailSticky-{{ section.id }} {
      position: fixed;
      right: 20px;
      bottom: 60px;
      z-index: 9999;
      width: 250px;
      height: 105px;
      box-sizing: border-box;
      background: #fff;
      color: #000;
      border-radius: 12px;
      box-shadow: 0 8px 22px rgba(0, 0, 0, .18);
      font-family: inherit;
      transition: opacity .2s ease, transform .2s ease;
    }

    #EmailSticky-{{ section.id }}.is-hidden {
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transform: translateY(10px);
    }

    #EmailSticky-{{ section.id }} .imnot-email-sticky__content {
      padding: 20px 12px 12px;
    }

    #EmailSticky-{{ section.id }} .imnot-email-sticky__description {
      margin: 0 0 12px;
      color: #000;
      font-size: 11px;
      font-weight: 500;
      line-height: 1.3;
      text-align: center;
    }

    #EmailSticky-{{ section.id }} .imnot-email-sticky__field {
      display: flex;
      align-items: center;
      height: 30px;
      border: 1px solid #9a9a9a;
      box-sizing: border-box;
    }

    #EmailSticky-{{ section.id }} .imnot-email-sticky__field input {
      width: 100%;
      min-width: 0;
      height: 100%;
      padding: 0 9px;
      border: 0;
      border-radius: 0;
      outline: 0;
      box-shadow: none;
      background: transparent;
      color: #000;
      font-family: inherit;
      font-size: 16px;
    }
    #EmailSticky-{{ section.id }} .imnot-email-sticky__field input::placeholder {
      font-size: 11px;
      color: #9b9b9b;
      opacity: 1;
      text-transform: uppercase;
    }
    #EmailSticky-{{ section.id }} .imnot-email-sticky__field button {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 32px;
      height: 100%;
      padding: 0;
      border: 0;
      background: transparent;
      color: #000;
      cursor: pointer;
    }

    #EmailSticky-{{ section.id }} .imnot-email-sticky__field button svg {
      width: 19px;
      height: 19px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    #EmailSticky-{{ section.id }} .imnot-email-sticky__close {
      position: absolute;
      top: -12px;
      right: 12px;
      width: 20px;
      height: 20px;
      padding: 5px;
      border: 0;
      border-radius: 50%;
      background: #000;
      color: #fff;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #EmailSticky-{{ section.id }} .imnot-email-sticky__close svg {
      width: 100%;
      height: 100%;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.2;
      stroke-linecap: round;
    }

    #EmailSticky-{{ section.id }} .imnot-email-sticky__message {
      font-size: 11px;
      text-align: center;
      line-height: 1.4;
    }

    #EmailSticky-{{ section.id }} .imnot-email-sticky__error {
      display: block;
      margin-top: 3px;
      color: #c00;
      font-size: 9px;
    }

    @media screen and (max-width: 749px) {
      #EmailSticky-{{ section.id }} {
        right: 12px;
        bottom: 12px;
      }
    }
  </style>

  <script>
    (function () {
      const sticky = document.getElementById('EmailSticky-{{ section.id }}');
      if (!sticky) return;

      const closeButton = sticky.querySelector('.imnot-email-sticky__close');

      closeButton.addEventListener('click', function () {
        sticky.classList.add('is-hidden');
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Email Sticky",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable Email Sticky",
      "default": true
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Sign up to get 10% off and early access to new collections!"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "YOU'RE IN. CHECK YOUR INBOX."
    }
  ],
  "presets": [
    {
      "name": "Email Sticky"
    }
  ]
}
{% endschema %}
